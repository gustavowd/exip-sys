diff --git a/include/procTypes.h b/include/procTypes.h
index 1a0e734..c3aebd0 100644
--- a/include/procTypes.h
+++ b/include/procTypes.h
@@ -395,6 +395,14 @@ struct dynArray {
 	 * The total number of entries in the array
 	 */
 	Index arrayEntries;
+
+	/**
+	 * Non-zero when the entries array was allocated by EXIP_MALLOC and can be
+	 * passed to EXIP_REALLOC. Static grammars (generated by exipg) leave it
+	 * zero: their arrays live in static storage and must be copied, not
+	 * reallocated, when they grow.
+	 */
+	unsigned char heapAllocated;
 };
 
 typedef struct dynArray DynArray;
diff --git a/src/common/src/dynamicArray.c b/src/common/src/dynamicArray.c
index 4a1fe3b..ac93c8f 100644
--- a/src/common/src/dynamicArray.c
+++ b/src/common/src/dynamicArray.c
@@ -15,6 +15,7 @@
 
 #include "dynamicArray.h"
 #include "memManagement.h"
+#include <string.h>
 
 /**
  * Used for fixing portability issue due to padding in DynArray derived structures such as
@@ -46,6 +47,7 @@ errorCode createDynArray(DynArray* dynArray, size_t entrySize, uint16_t chunkEnt
 	*count = 0;
 	dynArray->chunkEntries = chunkEntries;
 	dynArray->arrayEntries = chunkEntries;
+	dynArray->heapAllocated = 1;
 
 	return EXIP_OK;
 }
@@ -71,12 +73,26 @@ errorCode addEmptyDynEntry(DynArray* dynArray, void** entry, Index* entryID)
 			*base = EXIP_MALLOC(dynArray->entrySize * addedEntries);
 			if(*base == NULL)
 				return EXIP_MEMORY_ALLOCATION_ERROR;
+			dynArray->heapAllocated = 1;
+		}
+		else if(!dynArray->heapAllocated)
+		{
+			// Static array (e.g. a string table of a static grammar): it was
+			// not allocated by EXIP_MALLOC, so it must be copied instead of
+			// reallocated.
+			void* heapBase = EXIP_MALLOC(dynArray->entrySize * (*count + addedEntries));
+			if(heapBase == NULL)
+				return EXIP_MEMORY_ALLOCATION_ERROR;
+			memcpy(heapBase, *base, dynArray->entrySize * (*count));
+			*base = heapBase;
+			dynArray->heapAllocated = 1;
 		}
 		else
 		{
-			*base = EXIP_REALLOC(*base, dynArray->entrySize * (*count + addedEntries));
-			if(*base == NULL)
+			void* newBase = EXIP_REALLOC(*base, dynArray->entrySize * (*count + addedEntries));
+			if(newBase == NULL)
 				return EXIP_MEMORY_ALLOCATION_ERROR;
+			*base = newBase;
 		}
 
 		dynArray->arrayEntries = dynArray->arrayEntries + addedEntries;
@@ -133,5 +149,8 @@ errorCode delDynEntry(DynArray* dynArray, Index entryID)
 void destroyDynArray(DynArray* dynArray)
 {
 	void** base = &((OuterDynamicArray *)dynArray)->base;
-	EXIP_MFREE(*base);
+	if(dynArray->heapAllocated)
+		EXIP_MFREE(*base);
+	*base = NULL;
+	dynArray->heapAllocated = 0;
 }
diff --git a/src/common/src/memManagement.c b/src/common/src/memManagement.c
index 4888984..43cfafd 100644
--- a/src/common/src/memManagement.c
+++ b/src/common/src/memManagement.c
@@ -63,6 +63,22 @@ void freeAllMem(EXIStream* strm)
 		{
 		Index g;
 		DynGrammarRule* tmp_rule;
+		Index u, l;
+
+		// String table entries that survive the stream (the ones of a static
+		// schema) may point to the built-in grammars freed below. Unlink them,
+		// otherwise the next stream that uses the same schema follows a
+		// dangling grammar.
+		for(u = 0; u < strm->schema->uriTable.count; u++)
+		{
+			for(l = 0; l < strm->schema->uriTable.uri[u].lnTable.count; l++)
+			{
+				Index* elemGr = &strm->schema->uriTable.uri[u].lnTable.ln[l].elemGrammar;
+				if(*elemGr >= strm->schema->staticGrCount && *elemGr < strm->schema->grammarTable.count)
+					*elemGr = INDEX_MAX;
+			}
+		}
+
 		// Explicitly free the memory for any build-in grammars
 		for(g = strm->schema->staticGrCount; g < strm->schema->grammarTable.count; g++)
 		{
